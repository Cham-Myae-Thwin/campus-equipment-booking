{
  "name": "campus-equipment-booking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "tsc --noEmit",
    "test:evidence": "bash scripts/test-api.sh",
    "db:local": "wrangler d1 execute campus-booking-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute campus-booking-db --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "wrangler": "^4.41.0",
    "typescript": "^5.9.3"
  }
}